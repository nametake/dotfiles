[user]
  name = nametake
  email = nametake.kyarabuki@gmail.com

[commit]
  verbose = true

[push]
  default = current
  autoSetupRemote = true
  path = ~/.gitconfig.local

[pull]
  rebase = false
  ff = only

[diff]
  compactionHeuristic = true

[fetch]
  prune = true

[alias]
  tree = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset %Creset%cd%Creset' --abbrev-commit --date=format-local:'%Y/%m/%d %H:%M'
  default-branch = "!f () { git symbolic-ref --quiet refs/remotes/origin/HEAD >/dev/null || git remote set-head origin -a >/dev/null || return 1; d=$(git symbolic-ref --short refs/remotes/origin/HEAD) || return 1; echo \"${d#origin/}\"; };f"
  # merged = has an upstream (was pushed), reachable from origin/<default>, and not on its first-parent chain (has commits of its own)
  merged-branch = "!f () { default=$(git default-branch) || return 1; fp=$(git rev-list --first-parent \"origin/$default\"); git for-each-ref refs/heads --merged \"origin/$default\" --format='%(if)%(upstream)%(then)%(refname:short) %(objectname) %(worktreepath)%(end)' | grep . | grep -vE \"^(main|master|develop|$default) \" | while read -r b sha p; do echo \"$fp\" | grep -qxF \"$sha\" || echo \"$b $p\"; done; };f"
  delete-merged-branch = "!f () { merged=$(git merged-branch) || return 1; echo \"$merged\" | awk 'NF==1' | xargs -r git branch -d; wt=$(echo \"$merged\" | awk 'NF==2'); [ -z \"$wt\" ] && return 0; echo \"$wt\" | while read -r b p; do echo \"merged branch '$b' is still checked out in worktree: $p\" >&2; done; return 1; };f"
  ac = !git add -A && git commit
  b = branch
  ch = checkout
  sw = switch
  re = restore
  di = diff --ignore-all-space --ignore-blank-lines
  p = !git push -u origin `git rev-parse --abbrev-ref HEAD`
  pm = "!f () { default=$(git default-branch) || return 1; git switch \"$default\" || return 1; git pull --prune || return 1; git delete-merged-branch; rc=$?; git submodule update; return $rc; };f"
  open = !gh repo view --web
  prc = !gh pr create --web
  prs = !gh pr view --web
  pre = !gh pr edit

  w = worktree
  wl = worktree list
  wr = worktree remove

  common-root = "!sh -c 'dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\"'"
  repo-id = "!sh -c 'ghq_root=\"$(ghq root)\" || exit 1; repo_root=\"$(git common-root)\" || exit 1; case \"$repo_root\" in \"$ghq_root\"/*) printf \"%s\\n\" \"${repo_root#\"$ghq_root\"/}\" ;; *) echo \"repository is not under ghq root: $repo_root\" >&2; exit 1 ;; esac'"
  worktree-base = "!sh -c 'ghq_root=\"$(ghq root)\" || exit 1; repo_id=\"$(git repo-id)\" || exit 1; printf \"%s\\n\" \"$ghq_root/.worktree/$repo_id\"'"
  worktree-path = "!sh -c 'branch=\"${1:?usage: git worktree-path <branch>}\"; base=\"$(git worktree-base)\" || exit 1; printf \"%s\\n\" \"$base/$branch\"' -"
  wa = "!sh -c 'branch=\"${1:?usage: git wa <branch>}\"; path=\"$(git worktree-path \"$1\")\" || exit 1; git show-ref --verify --quiet \"refs/heads/$branch\" || git branch \"$branch\"; mkdir -p \"$(dirname \"$path\")\" || exit 1; git worktree add \"$path\" \"$branch\"' -"

[core]
  editor = "vim"
  excludesfile = ~/.gitignore
  ignorecase = false
  quotepath = false

[include]
  path = ~/.gitconfig.local

[ghq]
  root = ~/go/src
  root = ~/Workspace

[init]
  templatedir=~/.git_template
  defaultBranch = main

[url "git@github.com:"]
  insteadOf = https://github.com/

[merge]
  ff = false
